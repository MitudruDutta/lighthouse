# Host ports avoid 6379 and 8000, which other projects use on the dev machine.
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=26379
FALKORDB_BROWSER_PORT=23000
# Leave empty for the local Compose database, which listens on 127.0.0.1 only.
# Set both for any database that is reachable from another machine.
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
