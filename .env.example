# The settings of one copy of Lighthouse. ./setup.sh makes .env from this file and fills in
# the token; it asks for the model key.

# Ports on this computer. They avoid 6379 and 8000, which other programs often use.
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=26379
FALKORDB_BROWSER_PORT=23000
API_PORT=8100
SCREEN_PORT=3000
DOCS_PORT=3002
MEMORY_SITE_PORT=3003
MEMORY_SITE_URL=http://localhost:3003
MEMORY_API_PORT=8200
MEMORY_PUBLIC_API=http://localhost:8200
# Public addresses used for links between independently served sites.
LIGHTHOUSE_APP_URL=http://localhost:3000
LIGHTHOUSE_DOCS_URL=http://localhost:3002

# Leave empty for the local database, which listens on 127.0.0.1 only. Set both for any
# database that another machine can reach.
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# Google OAuth web client, shared by both products. Keep the secret server-side.
# Redirect URIs: http://localhost:3000/api/auth/google/callback
#               http://localhost:3003/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Application model providers. Keys are read by backend services only.
# Empty provider preserves the existing custom URL/key configuration below.
# Named providers: openai, anthropic, gemini, groq, deepseek, mistral,
# openrouter, commandcode, ollama. Set LIGHTHOUSE_MODEL to a model ID from that provider.
LIGHTHOUSE_MODEL_PROVIDER=
LIGHTHOUSE_MODEL_URL=https://ollama.com/v1
LIGHTHOUSE_MODEL=deepseek-v4.1-flash
LIGHTHOUSE_MODEL_KEY=
LIGHTHOUSE_MODEL_REASONING=
# Custom endpoints support chat, responses, or messages; named providers choose the protocol.
LIGHTHOUSE_MODEL_PROTOCOL=chat

# Add any provider keys you want to enable in the Desk model selector.
# Named providers use their own key, never another provider's key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
COMMANDCODE_API_KEY=
OLLAMA_API_KEY=

# Live ship positions at the busiest ports, from aisstream.io: free, sign in at
# https://aisstream.io and create a key under API Keys. Empty: live counts are off and
# the global view uses IMF PortWatch alone, which is about a week behind.
AISSTREAM_API_KEY=

# Optional comma-separated model allowlists replace the bundled provider choices.
# Empty allowlist hides that provider from the selector. No key is exposed to the browser.
# LIGHTHOUSE_OPENAI_MODELS=gpt-6-astra,gpt-6.1-sol,gpt-6-luna,gpt-5.4-mini
# LIGHTHOUSE_ANTHROPIC_MODELS=claude-sonnet-5-5,claude-haiku-5-5,claude-opus-5-5
# LIGHTHOUSE_GEMINI_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite
# LIGHTHOUSE_GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b,llama-3.1-8b-instant
# LIGHTHOUSE_DEEPSEEK_MODELS=deepseek-flash,deepseek-v4-pro
# LIGHTHOUSE_MISTRAL_MODELS=mistral-small-latest,mistral-large-latest
# LIGHTHOUSE_OPENROUTER_MODELS=openai/gpt-5.4-mini
# LIGHTHOUSE_COMMANDCODE_MODELS=deepseek/deepseek-v4-flash,claude-sonnet-4-6
# LIGHTHOUSE_OLLAMA_MODELS=gemma4:31b,deepseek-v4.1-flash

# Who may ask the desk: <token>=<company>/<person>, separated by commas. A token has at
# least 32 letters and digits (openssl rand -hex 24). Each company's conversations are kept
# in a graph of its own.
LIGHTHOUSE_DESK_USERS=
# The token that the screen signs in with by itself, for the one person at this computer.
# Leave it empty when others can reach the screen.
LIGHTHOUSE_TOKEN=
# Private diagnostics only. Separate from customer sign-in tokens; never sent to browser.
# ./setup.sh generates it. Read diagnostics with: python scripts/operator_diagnostics.py
LIGHTHOUSE_OPERATOR_TOKEN=
# Shared by the two websites and the APIs: with it, the APIs limit sign-in attempts per
# browser instead of per website server. ./setup.sh generates it; never sent to browsers.
# Behind a reverse proxy, it must append the client to X-Forwarded-For (nginx:
# $proxy_add_x_forwarded_for). Without one, a client can name its own address.
LIGHTHOUSE_PROXY_TOKEN=
