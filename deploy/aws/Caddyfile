# One host for each API. Caddy obtains and renews the certificates, redirects http to https,
# and sets X-Forwarded-For to the client it saw. The websites run on Vercel and call these.

(site) {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
}

# The Memory API, for developers' project keys. The Memory site also serves it under its
# own address.
{$API_HOST} {
	import site
	reverse_proxy memory-api:8200
}

# The operations API, for the maritime console's server.
{$OPS_HOST} {
	import site
	reverse_proxy api:8100
}
